# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (email notifications)
RESEND_API_KEY=re_your_api_key_here

# Chromatic (visual testing)
# You don't need a token here. CI runs Chromatic on every push, using the
# CHROMATIC_PROJECT_TOKEN secret stored in GitHub. The Chromatic CLI does not read
# this file. To run it by hand, copy the token from the project's Manage page:
#   CHROMATIC_PROJECT_TOKEN=<token> npm run chromatic

# --- Staging Environment ---
# To run against a separate staging Supabase project:
# 1. Create a new Supabase project for staging
# 2. Copy this file to .env.staging.local
# 3. Replace the Supabase values with your staging project credentials
# 4. Run: npm run dev:staging
